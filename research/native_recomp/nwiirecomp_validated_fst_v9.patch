--- /dev/null
+++ b/nWiiRuntime/include/runtime/validated_fst_v9.h
@@ -0,0 +1,76 @@
+#pragma once
+// Source-only, bounds-checked GameCube/Wii FST parser. No game data included.
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace nwii::runtime {
+struct ValidatedFstFileV9 {
+    std::string guest_path;
+    uint64_t disc_offset;
+    uint32_t size;
+};
+struct ValidatedFstV9 {
+    std::vector<ValidatedFstFileV9> files;
+    uint32_t entries = 0;
+};
+namespace fst_v9_detail {
+inline uint32_t be32(const uint8_t* p) {
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 |
+           uint32_t(p[2]) << 8 | uint32_t(p[3]);
+}
+inline bool valid_component(const std::string& name) {
+    if (name.empty() || name == "." || name == ".." || name.size() > 255) return false;
+    for (unsigned char c : name)
+        if (c < 32 || c == 127 || c == '/' || c == '\\' || c == ':') return false;
+    return true;
+}
+} // namespace fst_v9_detail
+
+inline bool parse_validated_fst_v9(std::span<const uint8_t> fst, bool is_wii,
+                                   ValidatedFstV9& out, std::string& error) {
+    using namespace fst_v9_detail;
+    auto fail = [&](const char* why) { error = why; return false; };
+    out = {};
+    error.clear();
+    if (fst.size() < 13) return fail("FST too small");
+    if (fst[0] != 1) return fail("FST root is not a directory");
+    const uint32_t count = be32(fst.data() + 8);
+    if (count == 0 || uint64_t(count)*12 >= fst.size()) return fail("FST entry table outside bounds");
+    if (be32(fst.data() + 4) != 0) return fail("FST root parent index not zero");
+    const size_t string_start = size_t(count)*12;
+    struct Directory { uint32_t index; uint32_t end; std::string guest; };
+    std::vector<Directory> parents{{0, count, ""}};
+    out.entries = count;
+    for (uint32_t i = 1; i < count; ++i) {
+        while (parents.size() > 1 && i >= parents.back().end) parents.pop_back();
+        if (i >= parents.back().end) return fail("FST entry escapes parent directory");
+        const uint8_t* e = fst.data() + size_t(i)*12;
+        if (e[0] != 0 && e[0] != 1) return fail("invalid FST entry type");
+        const uint32_t name_offset = (uint32_t(e[1]) << 16) | (uint32_t(e[2]) << 8) | e[3];
+        if (name_offset >= fst.size() - string_start) return fail("FST name outside string table");
+        const uint8_t* name_start = fst.data() + string_start + name_offset;
+        const size_t available = fst.size() - string_start - name_offset;
+        const void* endptr = std::memchr(name_start, 0, available);
+        if (!endptr) return fail("unterminated FST filename");
+        const auto endname = static_cast<const uint8_t*>(endptr);
+        const std::string name(reinterpret_cast<const char*>(name_start), size_t(endname-name_start));
+        if (!valid_component(name)) return fail("unsafe FST path component");
+        const std::string guest = parents.back().guest.empty() ? name : parents.back().guest + "/" + name;
+        const uint32_t offset = be32(e+4);
+        const uint32_t length = be32(e+8);
+        if (e[0] == 1) {
+            if (offset != parents.back().index) return fail("FST directory has incorrect parent index");
+            if (length <= i || length > parents.back().end) return fail("FST directory end index invalid");
+            if (parents.size() >= 1024) return fail("FST directory nesting too deep");
+            parents.push_back({i,length,guest});
+        } else {
+            out.files.push_back({guest,uint64_t(offset) << (is_wii ? 2 : 0),length});
+        }
+    }
+    return true;
+}
+} // namespace nwii::runtime
